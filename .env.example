# Copy to .env and fill in. Never commit .env (it holds secrets).

# ── Spotify (optional for the multi-user server; required for the single-user pipeline) ──
# developer.spotify.com/dashboard → your app. In development mode only accounts you add there (max 5) can connect.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
# Single-user pipeline's redirect (loopback, registered in the Spotify app):
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Multi-user server's redirect (also register it in the Spotify app). Spotify only accepts https:// or loopback,
# so for other devices on your network use the HTTPS address from docs/DEPLOYMENT.md.
FREQUENCY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8060/api/v1/connections/spotify/callback

# ── Last.fm (optional): free key at https://www.last.fm/api/account/create ──
LASTFM_API_KEY=

# ── PostgreSQL ──
DATABASE_URL=postgresql://frequency_app:CHANGE_ME@localhost:5432/frequency
# Tests rebuild this one from scratch; its name must contain "test".
DATABASE_URL_TEST=postgresql://frequency_app:CHANGE_ME@localhost:5432/frequency_test

# ── Secrets ──
# Encrypts stored provider tokens and signs OAuth state. Generate: python -m frequency.cli new-secret
# Losing it means every user has to reconnect their sources. Rotating: see docs/RUNBOOK.md.
FREQUENCY_SECRET_KEY=
# FREQUENCY_SECRET_KEY_PREVIOUS=          # old key(s), comma-separated, still accepted for decryption during rotation

# ── Server ──
FREQUENCY_HOST=127.0.0.1                  # 0.0.0.0 to serve your local network (behind HTTPS, see docs/DEPLOYMENT.md)
FREQUENCY_PORT=8060
FREQUENCY_SECURE_COOKIES=0                # 1 when the site is reached over HTTPS
FREQUENCY_ALLOW_SIGNUP=1                  # 0 to close sign-ups (create accounts with the CLI instead)
FREQUENCY_SESSION_DAYS=14
FREQUENCY_UPLOAD_MAX_MB=50
# FREQUENCY_CLIP_STORE=/path/to/clips     # default: data/clips
FREQUENCY_KEEP_CLIPS=0                    # 1 keeps preview clips after measuring (~0.5 MB each, ~1,000 per new library)
